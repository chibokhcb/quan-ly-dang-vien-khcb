# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Mode configuration: set to "true" for offline mock preview, "false" for live Firebase
VITE_USE_MOCK_DATA="true"

# Bootstrap Admin Emails (comma separated) for initial SUPER_ADMIN assignment
BOOTSTRAP_ADMIN_EMAILS="chibokhcb@ctump.edu.vn,admin@ctump.edu.vn"

# Allowed Domain for authentication (e.g. ctump.edu.vn)
ALLOWED_EMAIL_DOMAINS="ctump.edu.vn"

# Firebase Client Configuration (Vite)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Firebase Admin Service Account (JSON string or base64) for Node backend
FIREBASE_SERVICE_ACCOUNT=""
